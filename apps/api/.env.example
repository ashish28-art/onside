PORT=4000
NODE_ENV=development
DATABASE_URL="postgresql://football:football@localhost:5432/football_platform"
REDIS_URL="redis://localhost:6379"
WEB_ORIGIN="http://localhost:3000"

# Required: key from https://www.football-data.org (free tier available).
# The API fails to start without it.
FOOTBALL_DATA_API_KEY="your-football-data-api-key"
# Optional: override the provider base URL (defaults to https://api.football-data.org/v4)
# FOOTBALL_DATA_BASE_URL="https://api.football-data.org/v4"

# These sign our JWTs. In real production you'd generate long random
# strings (e.g. `openssl rand -base64 48`) -- for local dev, anything
# reasonably long and random is fine. Keep the two DIFFERENT from each
# other, so an access token secret leak doesn't also compromise refresh
# tokens.
JWT_ACCESS_SECRET="dev-access-secret-change-me-please-12345"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me-too-67890"
